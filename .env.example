HENRIKDEV_API_KEY=
WILD_TEAM_NAME=
WILD_TEAM_TAG=
WILD_AFFINITY=na
# WILD_DB_PATH=./data/wild.sqlite3

# Supabase Postgres — used by the ingestion pipeline (ingest.py, xlsx_import.py,
# derive.py, set_profiles.py). Use the direct connection string (port 5432),
# not the pooled one — these scripts run locally/persistently, not serverless.
# Get this from Supabase: Project Settings -> Database -> Connection string (URI).
DATABASE_URL=postgresql://postgres:[YOUR-PASSWORD]@db.[PROJECT-REF].supabase.co:5432/postgres
