{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "wild-tracker",
      "runtimeExecutable": ".venv/bin/uvicorn",
      "runtimeArgs": ["wild_tracker.webapp:app", "--reload", "--port", "8000", "--app-dir", "src"],
      "port": 8000
    },
    {
      "name": "web",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["--prefix", "web", "run", "dev"],
      "port": 3000
    }
  ]
}
